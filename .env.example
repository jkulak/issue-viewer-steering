# Settings for issue-viewer. It reads ./.env from the directory it starts in (or the file named
# with --env-file); a variable set in the environment wins over the same line here. Restart the
# viewer after changing this file.

# Issue directories to show, comma-separated: name=/absolute/path[:ro]
# ":ro" makes one read-only: the viewer never writes to it and hides every write control for it.
PROJECTS=example=/Users/you/dev/example-project/tasks,other=/Users/you/dev/other-project/tasks:ro

# Directory tree the Open button browses: /absolute/path[:ro]
# Folders opened from it are read-only with ":ro". Empty turns Open off.
OPEN_ROOT=

# Port on 127.0.0.1 the viewer listens on; 0 lets the system pick a free one
PORT=8090

# Extra host names the viewer answers to, comma-separated (localhost and 127.0.0.1 always work)
ALLOWED_HOSTS=

# Time zone for comment timestamps and displayed dates; empty uses the system's
TZ=Europe/Warsaw

# How often open pages check for changes on disk, in seconds; 0 turns it off
REFRESH_SECONDS=3

# debug, info, warning or error
LOG_LEVEL=INFO
