# Issue directories to show, comma-separated: name=/absolute/path/on/the/host[:ro]
# Only these directories are mounted into the container. ":ro" mounts one read-only and hides
# every write control for it. Run `make up` (or `make mounts`) after changing this line.
PROJECTS=example=/Users/you/dev/example-project/tasks,other=/Users/you/dev/other-project/tasks:ro

# Port on 127.0.0.1 the viewer listens on
PORT=8090

# Extra host names the viewer answers to, comma-separated (localhost and 127.0.0.1 always work)
ALLOWED_HOSTS=

# Time zone for comment timestamps and displayed dates
TZ=Europe/Warsaw

# How often open pages check for changes on disk, in seconds; 0 turns it off
REFRESH_SECONDS=3

LOG_LEVEL=INFO
