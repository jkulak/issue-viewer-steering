{
  "info": {
    "title": "Issue viewer",
    "version": "2026.10.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "text/html": {}
            },
            "description": "An HTML page"
          },
          "default": {
            "description": "An error page, or {error} with Accept: application/json"
          }
        },
        "summary": "The projects"
      }
    },
    "/-/open": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "path",
            "required": false,
            "schema": {
              "description": "A folder relative to the open root",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/html": {}
            },
            "description": "An HTML page"
          },
          "default": {
            "description": "An error page, or {error} with Accept: application/json"
          }
        },
        "summary": "Browse the folders under the open root"
      },
      "post": {
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "properties": {
                  "_csrf": {
                    "description": "The token the page embeds; or send it as X-CSRF-Token",
                    "type": "string"
                  },
                  "path": {
                    "description": "A folder relative to the open root",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "303": {
            "description": "Saved; the Location header is the page to show next"
          },
          "default": {
            "description": "An error page, or {error} with Accept: application/json"
          }
        },
        "summary": "Open a folder under the open root as a project"
      }
    },
    "/{project_name}/-/version": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "project_name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "issue",
            "required": false,
            "schema": {
              "description": "An issue number; without it, the version of the whole project",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {}
            },
            "description": "{version}: a string, or null for an issue that is not there"
          },
          "default": {
            "description": "An error page, or {error} with Accept: application/json"
          }
        },
        "summary": "What open pages poll to notice a change on disk"
      }
    },
    "/{project_name}/issues": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "project_name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "description": "A search like GitHub's: is:open, label:bug, sort:updated-desc, words",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "description": "The page, from 1",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/html": {}
            },
            "description": "An HTML page"
          },
          "default": {
            "description": "An error page, or {error} with Accept: application/json"
          }
        },
        "summary": "The issue list"
      },
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "project_name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "properties": {
                  "_csrf": {
                    "description": "The token the page embeds; or send it as X-CSRF-Token",
                    "type": "string"
                  },
                  "description": {
                    "description": "The description, in Markdown",
                    "type": "string"
                  },
                  "labels": {
                    "description": "The labels",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "title": {
                    "description": "The title",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "303": {
            "description": "Saved; the Location header is the page to show next"
          },
          "default": {
            "description": "An error page, or {error} with Accept: application/json"
          }
        },
        "summary": "Create an issue"
      }
    },
